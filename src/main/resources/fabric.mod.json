{
  "schemaVersion": 1,
  "id": "linguabridge",
  "version": "${version}",
  "name": "LinguaBridge",
  "description": "Automatic bidirectional Minecraft chat translation directly from the client.",
  "authors": ["Mathys Lefebvre"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "fr.mathyslefebvre.linguabridge.LinguaBridgeClient"
    ],
    "modmenu": [
      "fr.mathyslefebvre.linguabridge.modmenu.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=20.0.1",
    "chat_heads": "*"
  }
}
